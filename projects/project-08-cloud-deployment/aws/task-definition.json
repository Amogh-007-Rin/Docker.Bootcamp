{
  "family": "users",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "user-service",
      "image": "YOUR_ECR_OR_DOCKERHUB/user-service:latest",
      "essential": true,
      "portMappings": [{ "containerPort": 3001, "protocol": "tcp" }]
    }
  ]
}
